{
  "expo": {
    "name": "TRUE STACK Poker: Real Money Poker",
    "slug": "truestack-poker",
    "version": "1.0.0",
    "scheme": "truestack",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "io.truestack.poker",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "usesAppleSignIn": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "io.truestack.poker",
      "versionCode": 1
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
